<Project Sdk="Microsoft.NET.Sdk">
  <!-- Load and capacity tests. How to run them: see LoadTests/README.md -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Same GC settings as the app, so memory numbers match what `dotnet run` uses. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RootNamespace>OpenTrade.LoadTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenTrade.csproj" />
  </ItemGroup>
</Project>
